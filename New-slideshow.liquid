<section id="pro-carousel-{{ section.id }}" class="pro-carousel">
  <div class="pro-carousel-wrapper">
    <div class="pro-carousel-track">
      {% for block in section.blocks %}
        <div class="pro-slide" {{ block.shopify_attributes }}>
          {% if block.settings.slide_link != blank %}
            <a
              href="{{ block.settings.slide_link }}"
              class="pro-full-image-link"
              aria-label="{{ block.settings.heading | escape }}"
            ></a>
          {% endif %}

          <div class="pro-media pro-desktop">
            {% if block.settings.desktop_image != blank %}
              {{
                block.settings.desktop_image
                | image_url: width: 3000
                | image_tag:
                  class: 'pro-image',
                  loading: 'lazy',
                  widths: '750,1100,1500,2000,2500,3000'
              }}
            {% endif %}
          </div>

          <div class="pro-media pro-mobile">
            {% if block.settings.mobile_image != blank %}
              {{
                block.settings.mobile_image
                | image_url: width: 1500
                | image_tag:
                  class: 'pro-image',
                  loading: 'lazy',
                  widths: '375,550,750,1100,1500'
              }}
            {% elsif block.settings.desktop_image != blank %}
              {{
                block.settings.desktop_image
                | image_url: width: 1500
                | image_tag:
                  class: 'pro-image',
                  loading: 'lazy',
                  widths: '375,550,750,1100,1500'
              }}
            {% endif %}
          </div>

          {% if section.settings.enable_overlay %}
            <div class="pro-overlay"></div>
          {% endif %}

          {% if block.settings.heading != blank
            or block.settings.text != blank
            or block.settings.button_label != blank
          %}
            <div class="pro-content">
              {% if block.settings.heading != blank %}
                <h2>{{ block.settings.heading }}</h2>
              {% endif %}

              {% if block.settings.text != blank %}
                <p>{{ block.settings.text }}</p>
              {% endif %}

              {% if block.settings.button_label != blank %}
                <a
                  href="{{ block.settings.button_link }}"
                  class="pro-btn"
                >
                  {{ block.settings.button_label }}
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 and section.settings.show_arrows %}
      <div class="pro-arrows-wrapper">
        <button
          type="button"
          class="pro-arrow pro-arrow-prev"
          aria-label="Previous slide"
        >
          <!-- Real Chevron Left Icon -->
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <button
          type="button"
          class="pro-arrow pro-arrow-next"
          aria-label="Next slide"
        >
          <!-- Real Chevron Right Icon -->
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>
</section>

<style>
  #pro-carousel-{{ section.id }} {
    --pro-transition: {{ section.settings.transition_speed }}ms;
  }

  #pro-carousel-{{ section.id }}.pro-carousel {
    position: relative;
    width: 100%;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    overflow: hidden;
  }

  #pro-carousel-{{ section.id }} .pro-carousel-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    {% if section.settings.height_option == 'custom' %}
      height: {{ section.settings.custom_height }}px;
    {% else %}
      height: auto;
    {% endif %}
  }

  #pro-carousel-{{ section.id }} .pro-carousel-track {
    display: flex;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    transform: translate3d(0, 0, 0);
    transition: transform var(--pro-transition) ease;
    will-change: transform;
  }

  #pro-carousel-{{ section.id }} .pro-slide {
    position: relative;
    flex: 0 0 100%;
    min-width: 100%;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  #pro-carousel-{{ section.id }} .pro-media {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.image_background }};
  }

  #pro-carousel-{{ section.id }} .pro-image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position }};
  }

  /* Overlay Style */
  #pro-carousel-{{ section.id }} .pro-overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    background-color: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  #pro-carousel-{{ section.id }} .pro-full-image-link {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: block;
  }

  #pro-carousel-{{ section.id }} .pro-mobile {
    display: none;
  }

  {% if section.settings.height_option == 'auto' %}
    #pro-carousel-{{ section.id }} .pro-carousel-wrapper,
    #pro-carousel-{{ section.id }} .pro-slide,
    #pro-carousel-{{ section.id }} .pro-media {
      height: auto;
    }

    #pro-carousel-{{ section.id }} .pro-image {
      height: auto;
      min-height: 1px;
    }
  {% endif %}

  /* Flexible Content Positioning for Desktop */
  #pro-carousel-{{ section.id }} .pro-content {
    position: absolute;
    z-index: 4;
    width: min({{ section.settings.content_width }}px, 90%);
    text-align: {{ section.settings.content_alignment }};
    pointer-events: none;
    display: flex;
    flex-direction: column;
    align-items: {% if section.settings.content_alignment == 'right' %}flex-end{% elsif section.settings.content_alignment == 'center' %}center{% else %}flex-start{% endif %};
    padding: {{ section.settings.content_padding_y }}px {{ section.settings.content_padding_x }}px;
    box-sizing: border-box;

    {% case section.settings.content_position %}
      {% when 'top-left' %}
        top: 0; left: 0;
      {% when 'top-center' %}
        top: 0; left: 50%; transform: translateX(-50%);
      {% when 'top-right' %}
        top: 0; right: 0;
      {% when 'middle-left' %}
        top: 50%; left: 0; transform: translateY(-50%);
      {% when 'center' %}
        top: 50%; left: 50%; transform: translate(-50%, -50%);
      {% when 'middle-right' %}
        top: 50%; right: 0; transform: translateY(-50%);
      {% when 'bottom-left' %}
        bottom: 0; left: 0;
      {% when 'bottom-center' %}
        bottom: 0; left: 50%; transform: translateX(-50%);
      {% when 'bottom-right' %}
        bottom: 0; right: 0;
    {% endcase %}
  }

  #pro-carousel-{{ section.id }} .pro-content h2 {
    margin: 0 0 {{ section.settings.heading_margin }}px;
    color: {{ section.settings.title_color }};
    font-size: {{ section.settings.title_size }}px;
    font-weight: {{ section.settings.title_weight }};
    line-height: 1.1;
  }

  #pro-carousel-{{ section.id }} .pro-content p {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size }}px;
    font-weight: {{ section.settings.text_weight }};
    line-height: 1.4;
  }

  /* Button Customization */
  #pro-carousel-{{ section.id }} .pro-btn {
    display: inline-block;
    margin-top: {{ section.settings.button_margin_top }}px;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text_color }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    border-radius: {{ section.settings.button_radius }}px;
    text-decoration: none;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    text-transform: {{ section.settings.button_text_transform }};
    line-height: 1.2;
    pointer-events: auto;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  #pro-carousel-{{ section.id }} .pro-btn:hover {
    background: {{ section.settings.button_hover_bg }};
    color: {{ section.settings.button_hover_text_color }};
    border-color: {{ section.settings.button_hover_border_color }};
  }

  /* Dynamic Navigation Container (Desktop) */
  #pro-carousel-{{ section.id }} .pro-arrows-wrapper {
    position: absolute;
    z-index: 6;
    display: flex;
    gap: {{ section.settings.arrow_gap }}px;
    padding: {{ section.settings.arrow_offset_y }}px {{ section.settings.arrow_offset_x }}px;
    box-sizing: border-box;

    {% case section.settings.arrows_position %}
      {% when 'bottom-right' %}
        bottom: 0; right: 0;
      {% when 'bottom-left' %}
        bottom: 0; left: 0;
      {% when 'bottom-center' %}
        bottom: 0; left: 50%; transform: translateX(-50%);
      {% when 'top-right' %}
        top: 0; right: 0;
      {% when 'top-left' %}
        top: 0; left: 0;
      {% when 'sides' %}
        top: 50%; left: 0; width: 100%;
        justify-content: space-between;
        transform: translateY(-50%);
        padding: 0 {{ section.settings.arrow_offset_x }}px;
    {% endcase %}
  }

  #pro-carousel-{{ section.id }} .pro-arrow {
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: {{ section.settings.arrow_bg }};
    color: {{ section.settings.arrow_color }};
    border-radius: {{ section.settings.arrow_radius }}px;
    cursor: pointer;
    transition: opacity 0.2s ease, background 0.2s ease;
  }

  #pro-carousel-{{ section.id }} .pro-arrow:hover {
    opacity: 0.85;
  }

  #pro-carousel-{{ section.id }} .pro-arrow svg {
    width: {{ section.settings.arrow_icon_size }}px;
    height: {{ section.settings.arrow_icon_size }}px;
    display: block;
  }

  /* Responsive Mobile View */
  @media screen and (max-width: 749px) {
    #pro-carousel-{{ section.id }} .pro-desktop {
      display: none;
    }
    #pro-carousel-{{ section.id }} .pro-slide {
      border-radius:0px;
    }
    #pro-carousel-{{ section.id }} .pro-mobile {
      display: flex;
    }

    {% if section.settings.height_option == 'custom' %}
      #pro-carousel-{{ section.id }} .pro-carousel-wrapper {
        height: {{ section.settings.mobile_height }}px;
      }
    {% endif %}

    #pro-carousel-{{ section.id }} .pro-content {
      width: 100%;
      max-width: 100%;
      padding: 20px;
      text-align: {{ section.settings.mobile_content_alignment }};
      align-items: {% if section.settings.mobile_content_alignment == 'right' %}flex-end{% elsif section.settings.mobile_content_alignment == 'center' %}center{% else %}flex-start{% endif %};

      {% case section.settings.mobile_content_position %}
        {% when 'top' %}
          top: 0; bottom: auto; left: 50%; transform: translateX(-50%);
        {% when 'center' %}
          top: 50%; bottom: auto; left: 50%; transform: translate(-50%, -50%);
        {% when 'bottom' %}
          top: auto; bottom: 0; left: 50%; transform: translateX(-50%);
      {% endcase %}
    }

    #pro-carousel-{{ section.id }} .pro-content h2 {
      font-size: {{ section.settings.mobile_title_size }}px;
      font-weight: {{ section.settings.mobile_title_weight }};
      margin-bottom: {{ section.settings.mobile_heading_margin }}px;
    }

    #pro-carousel-{{ section.id }} .pro-content p {
      font-size: {{ section.settings.mobile_text_size }}px;
      font-weight: {{ section.settings.mobile_text_weight }};
    }

    #pro-carousel-{{ section.id }} .pro-btn {
      margin-top: {{ section.settings.mobile_button_margin }}px;
      padding: 8px 18px;
      font-size: {{ section.settings.mobile_button_font_size }}px;
    }

    /* Mobile Navigation Container */
    #pro-carousel-{{ section.id }} .pro-arrows-wrapper {
      padding: 15px;
      gap: 8px;

      {% case section.settings.mobile_arrows_position %}
        {% when 'bottom-right' %}
          top: auto; bottom: 0; left: auto; right: 0; transform: none; width: auto; justify-content: flex-end;
        {% when 'bottom-left' %}
          top: auto; bottom: 0; left: 0; right: auto; transform: none; width: auto; justify-content: flex-start;
        {% when 'bottom-center' %}
          top: auto; bottom: 0; left: 50%; right: auto; transform: translateX(-50%); width: auto; justify-content: center;
        {% when 'sides' %}
          top: 50%; bottom: auto; left: 0; right: auto; width: 100%; justify-content: space-between; transform: translateY(-50%); padding: 0 10px;
      {% endcase %}
    }

    #pro-carousel-{{ section.id }} .pro-arrow {
      width: {{ section.settings.mobile_arrow_size }}px;
      height: {{ section.settings.mobile_arrow_size }}px;
    }

    #pro-carousel-{{ section.id }} .pro-arrow svg {
      width: {{ section.settings.mobile_arrow_icon_size }}px;
      height: {{ section.settings.mobile_arrow_icon_size }}px;
    }
  }
</style>

<script>
(function () {
  function initProCarousel() {
    const section = document.getElementById('pro-carousel-{{ section.id }}');
    if (!section) return;

    const track = section.querySelector('.pro-carousel-track');
    const slides = Array.from(track.querySelectorAll('.pro-slide'));
    const nextBtn = section.querySelector('.pro-arrow-next');
    const prevBtn = section.querySelector('.pro-arrow-prev');

    if (!track || slides.length <= 1) return;

    if (section.dataset.initialized === 'true') return;
    section.dataset.initialized = 'true';

    const total = slides.length;
    let currentIndex = 1;
    let isMoving = false;
    let autoplayTimer = null;

    const autoplayEnabled = {{ section.settings.autoplay | json }};
    const autoplaySpeed = {{ section.settings.autoplay_speed | times: 1000 }};
    const transitionSpeed = {{ section.settings.transition_speed }};

    const firstClone = slides[0].cloneNode(true);
    const lastClone = slides[total - 1].cloneNode(true);

    firstClone.classList.add('pro-slide-clone');
    lastClone.classList.add('pro-slide-clone');

    track.appendChild(firstClone);
    track.insertBefore(lastClone, slides[0]);

    function updateSlider(animate) {
      track.style.transition = animate ? 'transform ' + transitionSpeed + 'ms ease' : 'none';
      track.style.transform = 'translate3d(-' + (currentIndex * 100) + '%, 0, 0)';
    }

    updateSlider(false);

    function nextSlide() {
      if (isMoving) return;
      isMoving = true;
      currentIndex++;
      updateSlider(true);
      resetAutoplay();
    }

    function previousSlide() {
      if (isMoving) return;
      isMoving = true;
      currentIndex--;
      updateSlider(true);
      resetAutoplay();
    }

    if (nextBtn) nextBtn.addEventListener('click', nextSlide);
    if (prevBtn) prevBtn.addEventListener('click', previousSlide);

    track.addEventListener('transitionend', function () {
      if (currentIndex === total + 1) {
        currentIndex = 1;
        updateSlider(false);
      }
      if (currentIndex === 0) {
        currentIndex = total;
        updateSlider(false);
      }
      isMoving = false;
    });

    function startAutoplay() {
      if (!autoplayEnabled || total <= 1) return;
      stopAutoplay();
      autoplayTimer = setInterval(function () {
        if (isMoving) return;
        isMoving = true;
        currentIndex++;
        updateSlider(true);
      }, autoplaySpeed);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    function resetAutoplay() {
      if (!autoplayEnabled) return;
      stopAutoplay();
      startAutoplay();
    }

    {% if section.settings.pause_on_hover %}
      section.addEventListener('mouseenter', stopAutoplay);
      section.addEventListener('mouseleave', startAutoplay);
    {% endif %}

    let touchStartX = 0;
    let touchEndX = 0;

    section.addEventListener('touchstart', function (event) {
      touchStartX = event.changedTouches[0].screenX;
    }, { passive: true });

    section.addEventListener('touchend', function (event) {
      touchEndX = event.changedTouches[0].screenX;
      const difference = touchStartX - touchEndX;
      if (Math.abs(difference) < 50) return;
      if (difference > 0) nextSlide();
      else previousSlide();
    }, { passive: true });

    window.addEventListener('resize', function () {
      if (!isMoving) updateSlider(false);
    });

    startAutoplay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProCarousel);
  } else {
    initProCarousel();
  }

  document.addEventListener('shopify:section:load', function (event) {
    if (event.detail && event.detail.sectionId === '{{ section.id }}') {
      const section = document.getElementById('pro-carousel-{{ section.id }}');
      if (section) section.dataset.initialized = 'false';
      initProCarousel();
    }
  });
})();
</script>

{% schema %}
{
  "name": "Pro Carousel Slider",
  "settings": [
    {
      "type": "header",
      "content": "Slider Settings"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Auto Slide",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Auto Slide Delay",
      "min": 2,
      "max": 15,
      "step": 1,
      "unit": "sec",
      "default": 5
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Slide Transition Speed",
      "min": 200,
      "max": 1500,
      "step": 50,
      "unit": "ms",
      "default": 600
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause Auto Slide on Hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Controls",
      "default": true
    },
    {
      "type": "header",
      "content": "Dimensions"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum Width",
      "min": 800,
      "max": 2500,
      "step": 25,
      "unit": "px",
      "default": 1450
    },
    {
      "type": "select",
      "id": "height_option",
      "label": "Height Type",
      "options": [
        { "value": "auto", "label": "Image Auto Height" },
        { "value": "custom", "label": "Custom Height" }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Desktop Height",
      "min": 300,
      "max": 1200,
      "step": 10,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile Height",
      "min": 200,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "header",
      "content": "Image Options"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image Fit",
      "options": [
        { "value": "contain", "label": "Show Full Image - No Crop" },
        { "value": "cover", "label": "Fill Section - Crop" }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Image Background",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Image Overlay Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_overlay",
      "label": "Enable Image Overlay",
      "default": false
