      "min": 10,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content Box Width",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 450
    },
    {
      "type": "header",
      "content": "Mobile Content Layout & Positioning"
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "label": "Content Position (Mobile)",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "label": "Text Alignment (Mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Desktop Typography"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title Size",
      "min": 18,
      "max": 90,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title Weight",
      "options": [
        { "value": "300", "label": "300 (Light)" },
